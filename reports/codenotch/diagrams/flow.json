      "participant": "provider",
      "from": 244,
      "to": 366,
      "type": "backend"
    },
    {
      "participant": "vendor",
      "from": 272,
      "to": 310,
      "type": "external"
    },
    {
      "participant": "archive",
      "from": 412,
      "to": 423,
      "type": "database"
    },
    {
      "participant": "notch",
      "from": 440,
      "to": 451,
      "type": "frontend"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "The tick is not the request",
      "items": [
        "shouldRefresh is a pure function of busy, elapsed, and reset-due",
        "Idle polling drops to every 5 minutes to spare the rate limit",
        "A window rolling over forces a pass so the alert is not late"
      ]
    },
    {
      "dot": "amber",
      "title": "Deadline, not cancellation",
      "items": [
        "A keychain read blocks a thread that Task.cancel() cannot reach",
        "The store abandons the pass so the next tick can run",
        "A per-provider generation counter discards a late answer"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure stays visible",
      "items": [
        "Errors become typed ProviderStatus values, not guessed numbers",
        "The last good reading survives and ages visibly",
        "signedOutByOwner is kept distinct from needsAuth on purpose"
      ]
    }
  ]
}