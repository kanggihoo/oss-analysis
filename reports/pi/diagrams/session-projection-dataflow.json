{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "세션 파일 → 모델 컨텍스트 (buildSessionProjection)",
    "output": "session-projection-dataflow.html",
    "viewBox": [
      1080,
      600
    ],
    "quality_profile": "showcase"
  },
  "stages": [
    {
      "label": "기록"
    },
    {
      "label": "저장"
    },
    {
      "label": "경로·compaction 선택"
    },
    {
      "label": "메시지 투영"
    },
    {
      "label": "LLM 요청"
    }
  ],
  "nodes": [
    {
      "id": "session",
      "type": "backend",
      "label": "AgentSession",
      "sublabel": "message_end 이벤트",
      "stage": 0,
      "row": 0,
      "tag": "_handleAgentEvent"
    },
    {
      "id": "compaction",
      "type": "backend",
      "label": "compaction",
      "sublabel": "prepareCompaction",
      "stage": 0,
      "row": 2,
      "tag": "요약 생성"
    },
    {
      "id": "append",
      "type": "backend",
      "label": "_appendEntry",
      "sublabel": "id + parentId, leaf 이동",
      "stage": 1,
      "row": 0,
      "tag": "append*"
    },
    {
      "id": "file",
      "type": "database",
      "label": "세션 JSONL",
      "sublabel": "append-only 파일",
      "stage": 1,
      "row": 2,
      "tag": "_persist"
    },
    {
      "id": "path",
      "type": "backend",
      "label": "buildSessionPath",
      "sublabel": "leaf → root",
      "stage": 2,
      "row": 2,
      "tag": "branch 선택"
    },
    {
      "id": "ctxentries",
      "type": "backend",
      "label": "buildContextEntries",
      "sublabel": "최신 compaction 기준",
      "stage": 2,
      "row": 0,
      "tag": "옛 entry 제외"
    },
    {
      "id": "settings",
      "type": "database",
      "label": "세션 설정",
      "sublabel": "model · thinkingLevel",
      "stage": 3,
      "row": 2
    },
    {
      "id": "project",
      "type": "backend",
      "label": "projectContextEntry",
      "sublabel": "entry → 메시지 + edit",
      "stage": 3,
      "row": 0,
      "tag": "null = 생략"
    },
    {
      "id": "prepare",
      "type": "backend",
      "label": "prepareRequest",
      "sublabel": "context 교체",
      "stage": 4,
      "row": 0,
      "tag": "AgentSession hook"
    },
    {
      "id": "convert",
      "type": "external",
      "label": "convertToLlm",
      "sublabel": "요약 → user 텍스트",
      "stage": 4,
      "row": 2,
      "tag": "→ streamFn"
    }
  ],
  "flows": [
    {
      "from": "session",
      "to": "append",
      "label": "appendMessage",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "compaction",
      "to": "append",
      "label": "CompactionEntry",
      "classification": "summary + firstKeptEntryId",
      "variant": "dashed"
    },
    {
      "from": "append",
      "to": "file",
      "label": "JSONL 한 줄",
      "variant": "emphasis",
      "labelAt": [
        315,
        200
      ]
    },
    {
      "from": "file",
      "to": "path",
      "label": "entries",
      "variant": "emphasis"
    },
    {
      "from": "path",
      "to": "ctxentries",
      "label": "활성 경로",
      "variant": "emphasis"
    },
    {
      "from": "path",
      "to": "settings",
      "label": "model_change 등"
    },
    {
      "from": "ctxentries",
      "to": "project",
      "label": "선택된 entry",
      "variant": "emphasis"
    },
    {
      "from": "project",
      "to": "prepare",
      "label": "projection.messages",
      "variant": "emphasis"
    },
    {
      "from": "prepare",
      "to": "convert",
      "label": "AgentMessage[]",
      "variant": "emphasis",
      "labelAt": [
        960,
        200
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "기록: 트리 구조의 append-only 파일",
      "items": [
        "모든 entry는 id와 parentId를 갖고, 새 entry는 현재 leaf의 자식이 된다",
        "branch는 leaf를 옛 entry로 옮기는 것뿐이라 파일에서 지우는 것이 없다",
        "파일은 user/assistant 메시지가 처음 생길 때 만들어진다 (~/.pi/agent/sessions/--cwd--)"
      ]
    },
    {
      "dot": "violet",
      "title": "선택: compaction과 context_edit",
      "items": [
        "최신 compaction entry(요약) + firstKeptEntryId부터의 entry + compaction 이후 entry만 남긴다",
        "context_edit는 대상 entry의 content를 교체하고, replacement가 null이면 모델 컨텍스트에서 뺀다",
        "custom · label · usage entry는 메시지를 만들지 않는다"
      ]
    },
    {
      "dot": "amber",
      "title": "compaction 기준 (기본값)",
      "items": [
        "contextTokens > contextWindow − reserveTokens(16384)이면 압축",
        "뒤에서부터 약 keepRecentTokens(20000)만큼 남기고 앞부분을 요약",
        "convertToLlm이 compactionSummary를 <summary> user 메시지로 바꿔 LLM에 보낸다"
      ]
    }
  ]
}